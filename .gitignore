# Godot 4+ specific ignores
.godot/
/android/
/reference/

# Local editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo

# Python caches and local credentials
__pycache__/
*.py[cod]
.env
.env.*
!.env.example

# Exported builds
/build/
/dist/
*.pck

# Oversized CC0 source (208 MB .bin); re-fetch with
# python3 tools/art/fetch_polyhaven.py model jacaranda_tree 1k
/assets/vendor/polyhaven_cc0/model/jacaranda_tree/*
!/assets/vendor/polyhaven_cc0/model/jacaranda_tree/PROVENANCE.json
!/assets/vendor/polyhaven_cc0/model/jacaranda_tree/.gdignore
